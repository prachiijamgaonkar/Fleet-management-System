# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# WebSocket URL of the backend's robot-ingestion endpoint
WS_URL=ws://localhost:8080/ws/robots

# HTTP URL of the backend, used to poll GET /config for live knob changes
CONTROL_URL=http://localhost:8080

# Starting fleet size (server's own FLEET_SIZE should match, or the
# simulator will auto-correct to the server's value within one poll cycle)
FLEET_SIZE=8

# Starting update interval, in ms
UPDATE_INTERVAL_MS=5000

# Extra bytes of filler added to each published message, for testing
# payload-size behavior. 0 = no padding.
PAYLOAD_PADDING_BYTES=0
