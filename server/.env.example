# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# Port the backend listens on
PORT=8080

# Default fleet size the server expects, until changed live via POST /config
FLEET_SIZE=8

# Default update interval (ms) the server expects, until changed live via POST /config
UPDATE_INTERVAL_MS=5000

# Shared secret required in the "x-admin-token" header to call POST /config.
# Falls back to "changeme" if unset — always set a real value before deploying.
ADMIN_TOKEN=changeme

# The simulator's own URL. Required — this is how the server pushes live
# config changes (fleet size, update interval) directly to the simulator,
# and also pings it every 10 minutes in production to keep a free-tier
# instance from going idle. For local dev, point this at wherever the
# simulator's own HTTP endpoint is listening (defaults to port 8081).
SIMULATOR_URL=http://localhost:8081

# Postgres connection for the robot_history table (per-robot movement/status
# history, separate from the in-memory live fleet state). Create the database
# yourself first (e.g. `createdb robot`) — the app creates the table on
# startup via TypeORM's `synchronize: true`.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=robot

# Set to "true" when connecting to a managed Postgres that requires SSL
# (e.g. Timescale Cloud). Leave unset/false for local Postgres.
DB_SSL=false
