# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# Port the backend listens on
PORT=8080

# Default fleet size the server expects, until changed live via POST /config
FLEET_SIZE=8

# Default update interval (ms) the server expects, until changed live via POST /config
UPDATE_INTERVAL_MS=5000

# Shared secret required in the "x-admin-token" header to call POST /config.
# Falls back to "changeme" if unset — always set a real value before deploying.
ADMIN_TOKEN=changeme
